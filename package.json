{
  "name": "flyrank-frontend-capstone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:ci": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1 --reporter=default --reporter=json --reporter=junit --outputFile.json=test-results/vitest-results.json --outputFile.junit=test-results/vitest-junit.xml",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.tests.json",
    "verify": "npm run typecheck && npm run test:ci && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
